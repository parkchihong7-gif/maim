{
  "name": "maim",
  "version": "0.1.0",
  "private": true,
  "description": "Claude 기반 네이버 블로그 콘텐츠 자동 생성 프로그램 (발행은 수동 복사)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/web dist/db && rm -rf dist/web/public && cp -r src/web/public dist/web/public && rm -rf dist/db/migrations && cp -r src/db/migrations dist/db/migrations && date -u +%Y-%m-%dT%H:%M:%SZ > dist/BUILD_AT",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test:image-pipeline": "tsx tests/test-image-pipeline.ts",
    "test:ai-cli": "tsx tests/test-ai-cli.ts"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@google-cloud/storage": "^8.1.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "luxon": "^3.5.0",
    "node-cron": "^3.0.3",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.7.5",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
