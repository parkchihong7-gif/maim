# 대시보드 바인딩 (기본은 로컬만 접근 가능하도록 127.0.0.1 유지)
HOST=127.0.0.1
PORT=4173

# 타임존 (매일 초안 생성 스케줄에 사용)
TIMEZONE=Asia/Seoul

# 하루 최대 자동 생성 개수 (하드 캡, 코드에서도 5로 강제됨)
POSTS_PER_DAY=5

# 무료 스톡 이미지 API 키
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# claude CLI 실행 파일 경로 (기본 PATH의 claude 사용)
CLAUDE_BIN=claude

# 설정 시 모든 API 요청에 x-dashboard-token 헤더가 일치해야 함.
# 로컬(127.0.0.1)에서만 쓸 경우 비워둬도 무방. SSH 터널 없이 VPS 대시보드를
# 부득이 직접 노출해야 할 때만 강한 임의 문자열로 설정할 것.
DASHBOARD_TOKEN=
