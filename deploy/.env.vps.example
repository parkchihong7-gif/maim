# VPS 배포용 환경 변수 예시. /opt/maim/.env 로 복사해서 사용하세요.
# 로컬용 .env.example과의 핵심 차이: DEPLOYMENT_MODE=vps, PLAYWRIGHT_HEADLESS=true 고정.

DEPLOYMENT_MODE=vps

# 대시보드를 외부에 직접 노출하지 마세요. SSH 터널이나 인증이 붙은 리버스 프록시를 통해서만 접근하세요.
# 예: ssh -L 4173:127.0.0.1:4173 user@vps-host 후 로컬에서 http://127.0.0.1:4173 접속
HOST=127.0.0.1
PORT=4173

TIMEZONE=Asia/Seoul
POSTS_PER_DAY=5
PUBLISH_WINDOW_START=09:00
PUBLISH_WINDOW_END=22:00

UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# 로컬에서 export-session 할 때 사용한 것과 동일한 암호를 입력해야 import-session이 성공합니다.
SESSION_EXPORT_PASSPHRASE=

# VPS는 디스플레이가 없으므로 반드시 true (헤드풀 로그인은 로컬에서만 수행)
PLAYWRIGHT_HEADLESS=true

CLAUDE_BIN=claude

# SSH 터널을 쓸 수 없어 대시보드를 부득이 직접 노출해야 한다면 반드시 설정하세요.
DASHBOARD_TOKEN=
