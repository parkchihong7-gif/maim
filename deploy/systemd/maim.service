[Unit]
Description=maim - Claude 기반 네이버 블로그 콘텐츠 자동 생성 프로그램
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maim
WorkingDirectory=/opt/maim
EnvironmentFile=/opt/maim/.env
ExecStart=/usr/bin/node /opt/maim/dist/index.js
Restart=on-failure
RestartSec=10
# 크래시 반복 시 로그 폭주 방지
StartLimitIntervalSec=600
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
